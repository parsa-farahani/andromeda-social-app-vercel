# The environment which we save our images on that -> 'local' | 'vercel'
STORAGE_DRIVER=

# MongoDB connection string (include the database name)  ->  for vercel-deployment
MONGODB_URL=

# if your 'STORAGE_DRIVER' is 'local'  ->  set your local mongoDB url to this variable
MONGODB_URL_LOCAL=

# Secrets for signing JWTs: use long random values (openssl rand -base64 48)
ACCESS_TOKEN_SECRET_KEY=
REFRESH_TOKEN_SECRET_KEY=

# Vercel Blob (created automatically when a Blob store is linked)
BLOB_READ_WRITE_TOKEN=